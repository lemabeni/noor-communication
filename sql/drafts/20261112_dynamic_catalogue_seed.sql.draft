do $$ declare n_categories int; n_families int; n_subcategories int; n_projects int; n_pricing int; begin
 select count(*) into n_categories from public.catalogue_categories where slug in ('design-graphique','photographie','videographie','live-streaming','edition','communication-digitale','web-applications');
 select count(*) into n_families from public.catalogue_category_families f join public.catalogue_categories c on c.id=f.category_id where c.slug='design-graphique';
 select count(*) into n_subcategories from public.catalogue_subcategories;
 select count(*) into n_projects from public.projects where slug in ('logo-resurrection','logo-nzambe-kaka','logo-fascitech','hoodie-yeshua','tshirt-nzambe-kaka','tshirt-20ans','conjer','nzambe-kaka-affiche','culte-dominical','convention-exode','tabeera','sept-fois','impact-jeunesse','jeune-courageux','salon-gb-pro','cillia-beauty','eau-saine','save-the-date','ruth-ndanda','bon-debut-semaine','croissance-eglise','pais-mes-brebis','pharisien-moderne','studio-1','studio-2','studio-3','studio-4','outdoor-1','outdoor-2','outdoor-3','evenement-1','evenement-2','evenement-3','evenement-4','beaute-1','beaute-2');
 select count(*) into n_pricing from public.service_pricing where service in ('Logo simple','Logo complexe ou illustré','Identité visuelle basique','Charte graphique complète','Flyer simple','Flyer essentiel','Flyer upgrade','Bannière réseaux sociaux','Carrousel (1 à 10 slides)','Carte de visite','Kakemono simple','Kakemono upgrade','Couverture de livre','Page de garde, rapport','Mise en page de documents','Packaging simple','Packaging moyen','Packaging upgrade','Photo studio','Photo outdoor et corporate','Photo événement','Vidéo simple','Vidéo pro','Motion design','Live streaming','Photo beauté','Photo produit');
 if n_categories <> 7 or n_families <> 2 or n_subcategories <> 26 or n_projects <> 36 or n_pricing <> 27 then raise exception 'Seed validation failed: categories %, families %, subdivisions %, projects %, tariffs %', n_categories,n_families,n_subcategories,n_projects,n_pricing; end if;
 if exists (select 1 from public.catalogue_categories where is_published) or exists (select 1 from public.catalogue_category_families where is_published) or exists (select 1 from public.catalogue_subcategories where is_published) or exists (select 1 from public.projects where slug in ('logo-resurrection','logo-nzambe-kaka','logo-fascitech','hoodie-yeshua','tshirt-nzambe-kaka','tshirt-20ans','conjer','nzambe-kaka-affiche','culte-dominical','convention-exode','tabeera','sept-fois','impact-jeunesse','jeune-courageux','salon-gb-pro','cillia-beauty','eau-saine','save-the-date','ruth-ndanda','bon-debut-semaine','croissance-eglise','pais-mes-brebis','pharisien-moderne','studio-1','studio-2','studio-3','studio-4','outdoor-1','outdoor-2','outdoor-3','evenement-1','evenement-2','evenement-3','evenement-4','beaute-1','beaute-2') and is_published) or exists (select 1 from public.service_pricing where service in ('Logo simple','Logo complexe ou illustré','Identité visuelle basique','Charte graphique complète','Flyer simple','Flyer essentiel','Flyer upgrade','Bannière réseaux sociaux','Carrousel (1 à 10 slides)','Carte de visite','Kakemono simple','Kakemono upgrade','Couverture de livre','Page de garde, rapport','Mise en page de documents','Packaging simple','Packaging moyen','Packaging upgrade','Photo studio','Photo outdoor et corporate','Photo événement','Vidéo simple','Vidéo pro','Motion design','Live streaming','Photo beauté','Photo produit') and is_published) then raise exception 'Seed validation failed: some seed rows are published'; end if;
end $$;

commit;

-- EXPECTED COUNTS: 7 categories; 2 families; 26 subdivisions; 36 projects; 27 tariffs.
-- This seed is idempotent for categories/families/subcategories/aliases/projects and pricing rows keyed by category_id + service.
-- Verify title, images, category/subcategory mapping and all tariff delays before applying.
-- Public website must continue using js/catalogue.js until dynamic read integration is validated.
