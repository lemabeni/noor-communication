  using (is_published = true and is_archived = false);
create policy catalogue_categories_admin_all
  on public.catalogue_categories for all to authenticated
  using (private.is_noor_admin()) with check (private.is_noor_admin());

create policy catalogue_category_families_public_read
  on public.catalogue_category_families for select to anon, authenticated
  using (
    is_published = true and is_archived = false
    and exists (
      select 1 from public.catalogue_categories c
