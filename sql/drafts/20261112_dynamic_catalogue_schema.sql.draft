create policy catalogue_category_aliases_public_read
  on public.catalogue_category_aliases for select to anon, authenticated
  using (
    exists (
      select 1 from public.catalogue_categories c
      where c.id = category_id and c.is_published = true and c.is_archived = false
    )
  );
create policy catalogue_category_aliases_admin_all
  on public.catalogue_category_aliases for all to authenticated
  using (private.is_noor_admin()) with check (private.is_noor_admin());

-- Do not inherit broad default table grants. RLS remains the row-level boundary.
revoke all on table public.catalogue_categories from public, anon, authenticated;
revoke all on table public.catalogue_category_families from public, anon, authenticated;
revoke all on table public.catalogue_subcategories from public, anon, authenticated;
revoke all on table public.catalogue_category_aliases from public, anon, authenticated;

grant select on table public.catalogue_categories to anon, authenticated;
grant select on table public.catalogue_category_families to anon, authenticated;
grant select on table public.catalogue_subcategories to anon, authenticated;
grant select on table public.catalogue_category_aliases to anon, authenticated;

grant insert, update, delete on table public.catalogue_categories to authenticated;
grant insert, update, delete on table public.catalogue_category_families to authenticated;
grant insert, update, delete on table public.catalogue_subcategories to authenticated;
grant insert, update, delete on table public.catalogue_category_aliases to authenticated;

-- New nullable relation columns: keep legacy category text and existing records intact.
