-- DRAFT ONLY — DO NOT APPLY TO PRODUCTION
-- Noor Communication: dynamic catalogue relational schema
-- Prepared 2026-11-12 after read-only inspection of production.
-- Requires review by Claude/owner and explicit approval before migration.
--
-- Design:
--   categories          = seven public categories / commercial poles
--   category_families   = visible family groupings (currently two under Design graphique)
--   subcategories       = service subdivisions
--   category_aliases    = legacy URL/category anchors (identite, print, etc.)
--   projects.category_id/subcategory_id and service_pricing.category_id/subcategory_id
--                       = normalized relations; legacy text columns remain during transition.
--
-- Safety: no seed data, no data copy, no deletes, no renames, no migration execution here.
-- The existing local catalogue remains the public fallback until the new catalogue
-- is seeded, validated and consumed by the website.

begin;

create table public.catalogue_categories (
  id uuid primary key default gen_random_uuid(),
  slug text not null unique,
  name text not null,
  tagline text not null default '',
  pole_name text not null default '',
  sort_order integer not null default 0,
  is_published boolean not null default false,
  is_archived boolean not null default false,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint catalogue_categories_slug_format check (slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$')
);

create table public.catalogue_category_families (
  id uuid primary key default gen_random_uuid(),
  category_id uuid not null references public.catalogue_categories(id) on delete restrict,
  slug text not null,
  name text not null,
  description text not null default '',
  sort_order integer not null default 0,
  is_published boolean not null default false,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint catalogue_category_families_category_slug_key unique (category_id, slug),
  constraint catalogue_category_families_category_id_id_key unique (category_id, id),
  constraint catalogue_category_families_slug_format check (slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$')
);

create table public.catalogue_subcategories (
  id uuid primary key default gen_random_uuid(),
  category_id uuid not null references public.catalogue_categories(id) on delete restrict,
  family_id uuid null,
  slug text not null,
  name text not null,
  description text not null default '',
  sort_order integer not null default 0,
  is_published boolean not null default false,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint catalogue_subcategories_category_slug_key unique (category_id, slug),
  constraint catalogue_subcategories_category_id_id_key unique (category_id, id),
  constraint catalogue_subcategories_family_same_category_fkey
    foreign key (category_id, family_id)
    references public.catalogue_category_families(category_id, id)
    on delete restrict,
  constraint catalogue_subcategories_slug_format check (slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$')
);

create table public.catalogue_category_aliases (
  id uuid primary key default gen_random_uuid(),
  category_id uuid not null references public.catalogue_categories(id) on delete restrict,
  alias_slug text not null unique,
  created_at timestamptz not null default now(),
  constraint catalogue_category_aliases_slug_format check (alias_slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$')
);

alter table public.projects
  add column category_id uuid null,
  add column subcategory_id uuid null;

alter table public.projects
  add constraint projects_catalogue_category_fkey
    foreign key (category_id) references public.catalogue_categories(id) on delete restrict,
  add constraint projects_catalogue_subcategory_same_category_fkey
    foreign key (category_id, subcategory_id)
    references public.catalogue_subcategories(category_id, id) on delete restrict;

alter table public.service_pricing
  add column category_id uuid null,
  add column subcategory_id uuid null;

alter table public.service_pricing
  add constraint service_pricing_catalogue_category_fkey
    foreign key (category_id) references public.catalogue_categories(id) on delete restrict,
  add constraint service_pricing_catalogue_subcategory_same_category_fkey
    foreign key (category_id, subcategory_id)
    references public.catalogue_subcategories(category_id, id) on delete restrict;

-- Keep updated_at accurate for every catalogue entity.
create or replace function private.set_catalogue_updated_at()
returns trigger
language plpgsql
set search_path = pg_catalog
as $
begin
  new.updated_at := now();
  return new;
end;
$;

create trigger catalogue_categories_set_updated_at
  before update on public.catalogue_categories
  for each row execute function private.set_catalogue_updated_at();
create trigger catalogue_category_families_set_updated_at
  before update on public.catalogue_category_families
  for each row execute function private.set_catalogue_updated_at();
create trigger catalogue_subcategories_set_updated_at
  before update on public.catalogue_subcategories
  for each row execute function private.set_catalogue_updated_at();

-- RLS: public can read published catalogue rows only.
-- Authenticated users can mutate rows only if private.is_noor_admin() returns true.
alter table public.catalogue_categories enable row level security;
alter table public.catalogue_category_families enable row level security;
alter table public.catalogue_subcategories enable row level security;
alter table public.catalogue_category_aliases enable row level security;

create policy catalogue_categories_public_read
  on public.catalogue_categories for select to anon, authenticated
  using (is_published = true and is_archived = false);
create policy catalogue_categories_admin_all
  on public.catalogue_categories for all to authenticated
  using (private.is_noor_admin()) with check (private.is_noor_admin());

create policy catalogue_category_families_public_read
  on public.catalogue_category_families for select to anon, authenticated
  using (
    is_published = true and is_archived = false
    and exists (
      select 1 from public.catalogue_categories c
      where c.id = category_id and c.is_published = true and c.is_archived = false
    )
  );
create policy catalogue_category_families_admin_all
  on public.catalogue_category_families for all to authenticated
  using (private.is_noor_admin()) with check (private.is_noor_admin());

create policy catalogue_subcategories_public_read
  on public.catalogue_subcategories for select to anon, authenticated
  using (
    is_published = true and is_archived = false
    and exists (
      select 1 from public.catalogue_categories c
      where c.id = category_id and c.is_published = true and c.is_archived = false
    )
    and (
      family_id is null or exists (
        select 1 from public.catalogue_category_families f
        where f.id = family_id and f.category_id = catalogue_subcategories.category_id
          and f.is_published = true and f.is_archived = false
      )
    )
  );
create policy catalogue_subcategories_admin_all
  on public.catalogue_subcategories for all to authenticated
  using (private.is_noor_admin()) with check (private.is_noor_admin());

create policy catalogue_category_aliases_public_read
  on public.catalogue_category_aliases for select to anon, authenticated
  using (true);
create policy catalogue_category_aliases_admin_all
  on public.catalogue_category_aliases for all to authenticated
  using (private.is_noor_admin()) with check (private.is_noor_admin());

-- Do not inherit broad default table grants. RLS remains the row-level boundary.
revoke all on table public.catalogue_categories from public, anon, authenticated;
revoke all on table public.catalogue_category_families from public, anon, authenticated;
revoke all on table public.catalogue_subcategories from public, anon, authenticated;
revoke all on table public.catalogue_category_aliases from public, anon, authenticated;

grant select on table public.catalogue_categories to anon, authenticated;
grant select on table public.catalogue_category_families to anon, authenticated;
grant select on table public.catalogue_subcategories to anon, authenticated;
grant select on table public.catalogue_category_aliases to anon, authenticated;

grant insert, update, delete on table public.catalogue_categories to authenticated;
grant insert, update, delete on table public.catalogue_category_families to authenticated;
grant insert, update, delete on table public.catalogue_subcategories to authenticated;
grant insert, update, delete on table public.catalogue_category_aliases to authenticated;

-- New nullable relation columns: keep legacy category text and existing records intact.
-- Backfill is a separate reviewed migration after seed UUIDs/slugs are frozen.
-- Do not delete legacy text columns until all clients have migrated and parity is verified.

commit;

-- REQUIRED PRE-APPLY REVIEW / TESTS:
-- 1. Confirm these four catalogue table names do not already exist.
-- 2. Verify private.is_noor_admin() exists and has the expected SECURITY DEFINER/search_path.
-- 3. Verify authenticated and anon grants/RLS behaviour on a disposable project.
-- 4. Seed categories/families/subcategories as unpublished first.
-- 5. Map all 36 local realization slugs and 25 tariff rows; compare counts and every slug.
-- 6. Keep legacy projects.category and pricing.category values unchanged.
-- 7. Confirm category deletion is blocked while child rows or projects/pricing reference it.
-- 8. Confirm public can see only published, non-archived rows whose parent category/family is also published.
-- 9. Confirm a normal authenticated user cannot mutate.
-- 10. Do not execute this draft directly; convert to a numbered Supabase migration only after approval.
